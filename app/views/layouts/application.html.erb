<!DOCTYPE html>
<html lang="ja" class="h-full antialiased">
  <head>
    <title><%= content_for(:title) || "ABR 住居マスター" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="住居表示-住居マスター（mt_rsdtdsp_rsdt）の検索・編集・削除">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono&family=Noto+Sans+JP:wght@400;500;700&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full flex-col font-sans">
    <header class="border-b border-white/10 bg-slate-950/40 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-4 sm:px-6">
        <%= link_to root_path, class: "group flex items-center gap-3" do %>
          <span class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-rose-400 to-violet-500 text-sm font-bold text-slate-950 shadow-lg shadow-rose-500/20">R</span>
          <span class="font-semibold tracking-wide text-slate-100 group-hover:text-white">ABR 住居マスター</span>
        <% end %>
        <%# DB 検索と Elasticsearch 検索の切り替え %>
        <nav class="ml-6 flex gap-1 text-sm">
          <% [["DB 検索", root_path, controller_name == "rsdts"], ["Elasticsearch 検索", es_rsdts_path, controller_name == "es_rsdts"]].each do |label, path, active| %>
            <%= link_to label, path, class: active ? "rounded-lg bg-white/10 px-3 py-1.5 font-medium text-white" : "rounded-lg px-3 py-1.5 text-slate-400 hover:bg-white/5 hover:text-white" %>
          <% end %>
        </nav>
        <span class="ml-auto rounded-full border border-white/10 px-2.5 py-0.5 font-mono text-xs text-slate-400">mt_rsdtdsp_rsdt</span>
      </div>
    </header>

    <%= render "shared/flash" %>

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6">
      <%= yield %>
    </main>
    <footer class="py-6 text-center text-xs text-slate-500">Ruby on Rails + Active Record + Tailwind CSS</footer>
  </body>
</html>
