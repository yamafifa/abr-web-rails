<% r = @result %>
<% from = r.total.zero? ? 0 : (r.page - 1) * @query.per_page + 1 %>
<% to = (r.page - 1) * @query.per_page + r.rows.size %>
<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-white">住居の検索</h1>
    <p class="mt-1 text-sm text-slate-400">住居表示-住居マスター（東京都）を検索して、編集・削除します。</p>
  </div>

  <section class="rounded-2xl border border-white/10 bg-slate-900/50 p-5 shadow-xl shadow-black/20 backdrop-blur">
    <%= render "search_form", query: @query %>
  </section>

  <section class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900/50 shadow-xl shadow-black/20 backdrop-blur">
    <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-white/10 px-5 py-3 text-sm">
      <p class="text-slate-400"><span class="font-mono text-lg font-semibold text-white"><%= number_with_delimiter(r.total) %></span> 件</p>
      <p class="font-mono text-xs text-slate-500">
        <%= number_with_delimiter(from) %>–<%= number_with_delimiter(to) %> 件目 ／ <%= number_with_delimiter(r.page) %> / <%= number_with_delimiter(r.total_pages) %> ページ
      </p>
    </div>

    <% if r.rows.empty? %>
      <p class="px-5 py-16 text-center text-slate-500">該当する住居がありません</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="text-xs uppercase tracking-wider text-slate-500">
            <tr class="border-b border-white/5">
              <th class="px-5 py-3 font-medium">住所</th>
              <th class="px-3 py-3 font-medium">キー</th>
              <th class="px-3 py-3 font-medium">efct_date</th>
              <th class="px-3 py-3 font-medium">ablt_date</th>
              <th class="px-5 py-3 text-right font-medium">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% r.rows.each do |rsdt| %>
              <tr class="transition hover:bg-cyan-400/[0.04]">
                <td class="px-5 py-2.5 font-medium text-slate-100">
                  <%= rsdt.address %>
                  <% if rsdt.ablt_date %><span class="ml-2 rounded bg-slate-700/60 px-1.5 py-0.5 text-[10px] text-slate-400">廃止</span><% end %>
                </td>
                <td class="whitespace-nowrap px-3 py-2.5 font-mono text-xs text-slate-500"><%= rsdt.to_param %></td>
                <td class="whitespace-nowrap px-3 py-2.5 font-mono text-xs text-slate-400"><%= rsdt.efct_date %></td>
                <td class="whitespace-nowrap px-3 py-2.5 font-mono text-xs text-slate-400"><%= rsdt.ablt_date %></td>
                <td class="whitespace-nowrap px-5 py-2.5">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "編集", edit_rsdt_path(rsdt, back: @back), class: "rounded-md px-2.5 py-1 text-xs text-cyan-300 ring-1 ring-cyan-400/30 hover:bg-cyan-400/10" %>
                    <%= render "delete_button", rsdt:, back: @back, variant: :icon %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if r.total_pages > 1 %>
      <div class="border-t border-white/10 px-5 py-4">
        <%= render "pager", query: @query, page: r.page, total_pages: r.total_pages %>
      </div>
    <% end %>
  </section>
</div>
