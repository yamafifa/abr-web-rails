<% content_for :title, "#{@rsdt.address} の編集" %>
<div class="space-y-6">
  <div>
    <%= link_to "‹ 一覧に戻る", @back, class: "text-sm text-slate-400 hover:text-cyan-300" %>
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-white"><%= @rsdt.address %></h1>
    <dl class="mt-3 flex flex-wrap gap-2">
      <% Rsdt.primary_key.each do |col| %>
        <div class="rounded-lg border border-white/10 bg-slate-900/50 px-3 py-1.5">
          <dt class="font-mono text-[10px] text-slate-500"><%= col %></dt>
          <dd class="font-mono text-sm text-slate-200"><%= @rsdt[col].presence || tag.span("（空）", class: "text-slate-600") %></dd>
        </div>
      <% end %>
    </dl>
    <p class="mt-2 text-xs text-slate-500">主キーの 5 列は変更できません。</p>
  </div>

  <%# 「更新」を押すと、すぐには送らず、変わった項目をモーダルで見せる（confirm_controller.js の diff モード） %>
  <div data-controller="confirm" data-confirm-diff-value="true" data-action="submit->confirm#open">
    <%= form_with model: @rsdt, url: rsdt_path(@rsdt, back: @back), method: :patch,
          class: "rounded-2xl border border-white/10 bg-slate-900/50 shadow-xl shadow-black/20 backdrop-blur" do |f| %>
      <div class="grid gap-x-6 gap-y-5 p-6 sm:grid-cols-2 lg:grid-cols-3">
        <% Rsdt::ATTRIBUTE_RULES.each do |rule| %>
          <% name = rule[:name] %>
          <% error = @rsdt.errors[name].first %>
          <%# 入力したままの値（日付が正しくないときも、入力した文字を残す）と、DB の値（変更前） %>
          <% value = @rsdt.read_attribute_before_type_cast(name).to_s %>
          <% original = @rsdt.attribute_in_database(name).to_s %>
          <label class="<%= name == :remarks ? "block sm:col-span-2 lg:col-span-3" : "block" %>">
            <span class="mb-1.5 flex items-baseline justify-between font-mono text-xs text-slate-400">
              <span><%= name %><% if rule[:required] %><span class="ml-1 text-rose-400">*</span><% end %></span>
              <% if rule[:max] %><span class="text-[10px] text-slate-600">最大 <%= rule[:max] %> 文字</span><% end %>
            </span>
            <%= f.text_field name, value:, type: (rule[:type] == :date ? "date" : "text"),
                  "aria-invalid": error.present?,
                  data: { confirm_target: "field", column: name, original: },
                  class: "w-full rounded-lg border bg-slate-950/60 px-3 py-2 text-sm text-white outline-none transition focus:ring-2 #{error ? "border-rose-400/60 focus:ring-rose-400/20" : "border-white/10 focus:border-cyan-400/60 focus:ring-cyan-400/20"}" %>
            <% if error %><span class="mt-1 block text-xs text-rose-400"><%= error %></span><% end %>
          </label>
        <% end %>
      </div>
      <div class="flex items-center gap-3 border-t border-white/10 bg-slate-950/30 px-6 py-4">
        <%= link_to "キャンセル", @back, class: "ml-auto rounded-lg px-4 py-2 text-sm text-slate-300 hover:bg-white/5" %>
        <button type="submit" class="rounded-lg bg-gradient-to-r from-cyan-400 to-sky-500 px-6 py-2 text-sm font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:brightness-110 cursor-pointer">更新</button>
      </div>
    <% end %>
    <%= render layout: "shared/confirm_dialog", locals: { title: "この内容で更新しますか？", confirm_label: "更新する", danger: false } do %>
      <div data-confirm-target="diff"></div>
    <% end %>
  </div>

  <div class="flex justify-start">
    <%= render "delete_button", rsdt: @rsdt, back: @back, variant: :button %>
  </div>
</div>
