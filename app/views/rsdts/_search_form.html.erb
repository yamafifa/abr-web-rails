<%# 検索条件のフォーム。GET で送るので、条件は URL に残る（ページ番号は 1 に戻る） %>
<% input_class = "w-full rounded-lg border border-white/10 bg-slate-950/60 px-3 py-2 text-sm text-white placeholder:text-slate-600 outline-none transition focus:border-cyan-400/60 focus:ring-2 focus:ring-cyan-400/20" %>
<% c = query.criteria %>
<%= form_with url: root_path, method: :get, class: "grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-[1fr_1fr_9rem_6rem_6rem_auto_auto] lg:items-end" do %>
  <% [["市区町村", :city, c.city, "例：世田谷", ""], ["町字", :town, c.town, "例：上北沢", ""], ["丁目", :chome, c.chome, "例：一丁目", ""],
      ["blk_num", :blk, c.blk_num, "例：6", "font-mono"], ["rsdt_num", :rsdt, c.rsdt_num, "例：1", "font-mono"]].each do |label, name, value, placeholder, label_class| %>
    <label class="block">
      <span class="mb-1.5 block text-xs font-medium tracking-wide text-slate-400 <%= label_class %>"><%= label %></span>
      <%= text_field_tag name, value, placeholder:, class: input_class, id: nil,
            inputmode: (%i[blk rsdt].include?(name) ? "numeric" : nil), title: (%i[blk rsdt].include?(name) ? "完全一致" : nil) %>
    </label>
  <% end %>
  <label class="block">
    <span class="mb-1.5 block text-xs font-medium tracking-wide text-slate-400">表示件数</span>
    <%# 件数を変えたら、すぐに検索し直す（auto_submit_controller.js） %>
    <%= select_tag :per, options_for_select(RsdtListQuery::PER_PAGE_OPTIONS.map { ["#{it} 件", it] }, query.per_page),
          class: "#{input_class} pr-8", id: nil, data: { controller: "auto-submit", action: "change->auto-submit#submit" } %>
  </label>
  <button type="submit" class="rounded-lg bg-gradient-to-r from-cyan-400 to-sky-500 px-6 py-2 text-sm font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:brightness-110 cursor-pointer">検索</button>
<% end %>
